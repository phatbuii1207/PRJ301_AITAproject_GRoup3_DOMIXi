--o{ METHODS : \&quot;contains\&quot;\n\n    SOURCE_FILES ||--o{ ISSUES : \&quot;has\&quot;\n\n    METHODS ||--o{ ISSUES : \&quot;may have\&quot;\n\n    RULES ||--o{ ISSUES : \&quot;defines\&quot;\n\n    METHODS ||--o{ AI_OPTIMIZATIONS : \&quot;has\&quot;\n\n    SUBMISSIONS ||--|| ANALYSIS_REPORTS : \&quot;has\&quot;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="I666grEbtDcVGIyacYOt-1">
