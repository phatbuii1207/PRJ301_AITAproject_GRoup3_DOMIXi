# Shared Supabase PostgreSQL configuration (Windows/Linux/macOS).
# Copy to .env and fill your team's DB_USER / DB_PASSWORD privately. Never commit .env.
# Transaction pooler: disable server-side prepared statements for PostgreSQL JDBC.
DB_URL=jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=
# NetBeans Tomcat VM option: -Daita.env.file=C:/path/to/project/.env
# Alternatively set AITA_ENV_FILE or put the file at %USERPROFILE%/.aita.env.
# Native/local PostgreSQL example (replace the five DB fields above):
# DB_URL=jdbc:postgresql://localhost:5432/AST_CodeAnalysisDB
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=AST_CodeAnalysisDB
# DB_USER=aita

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
AI_PROVIDER=gemini
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2
AI_MAX_METHODS_PER_SUBMISSION=10
AI_EXTRACTED_ROOT=

# Submission storage outside webroot (default: ~/aita-uploads/submissions)
AITA_UPLOAD_DIR=
